# ─────────────────────────────────────────────────────────────────────────────
# CargoTracker — environment variables
# Copy to `api/.env` for local dev, or set these in Render's "Environment" tab.
# Nothing here is required to start; each enables a specific feature.
# ─────────────────────────────────────────────────────────────────────────────

# Live flight radar — FlightRadar24 API (primary source, covers cargo flights).
# Without it, the radar falls back to the free airplanes.live feed.
# Token format: "<id>|<secret>" (one string).
FR24_API_TOKEN=

# AFKL Cargo proxy (ScraperAPI key). Optional — only AFKL prefixes need it.
# Note: the code reads the double-P spelling SCRAPPER_API_KEY.
SCRAPPER_API_KEY=

# Email notifications (Resend) — NOT WIRED UP YET. These are reserved for a
# future notifications feature; the app currently doesn't read them, so you can
# leave them unset for now.
# RESEND_API_KEY=
# NOTIFY_FROM=
# NOTIFY_TO=

# ─────────────────────────────────────────────────────────────────────────────
# Render deployment notes
#   • PORT is injected by Render automatically — do NOT set it; the Dockerfile
#     reads $PORT (defaults to 3000 locally).
#   • The frontend is built into the image and served by the same process at /.
#     The API lives under /api/*. No separate frontend service needed.
#   • Build-time: VITE_API_URL defaults to "/api" (same origin) — no override
#     needed for the single-image deploy.
# ─────────────────────────────────────────────────────────────────────────────
