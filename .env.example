# Turnstile (Cloudflare bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# API URL for frontend (in docker use http://api:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Email notifications (Resend)
RESEND_API_KEY=
NOTIFY_FROM=tracking@koudrs.com
NOTIFY_TO=eduardo@koudrs.com

# Live flight radar (GET /api/flights) uses airplanes.live, which is free and
# requires NO API key. Non-commercial use; rate limit 1 req/sec (we batch +
# cache). No configuration needed.
