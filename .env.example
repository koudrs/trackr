# CargoTracker Environment Variables
# Copy to .env and fill in your values

# FlightRadar24 API (required for Live Radar)
# Sign up at https://fr24api.flightradar24.com/ - Explorer plan $9/mo
FR24_API_TOKEN=

# ScraperAPI (optional, for AFKL/MSC bypassing Akamai)
# https://www.scraperapi.com/ - free tier available
SCRAPPER_API_KEY=

# Email notifications (optional)
RESEND_API_KEY=
NOTIFY_FROM=tracking@yourdomain.com
NOTIFY_TO=you@yourdomain.com
